@echo off
cd /d "%~dp0"
echo Installing requirements...
py -m pip install -r requirements.txt || python -m pip install -r requirements.txt
echo Training model...
py -m rental_risk train || python -m rental_risk train
echo Analysing sample agreements...
py -m rental_risk analyze data\sample_agreements\leave_and_license_risky.pdf data\sample_agreements\residential_lease_balanced.docx data\sample_agreements\unnumbered_room_rental.txt data\sample_agreements\clause_list.txt || python -m rental_risk analyze data\sample_agreements\leave_and_license_risky.pdf data\sample_agreements\residential_lease_balanced.docx data\sample_agreements\unnumbered_room_rental.txt data\sample_agreements\clause_list.txt
echo Writing evaluation...
py -m rental_risk evaluate || python -m rental_risk evaluate
echo.
echo Done. Reports are in the "reports" folder. Opening the dashboard...
start "" "Open_Dashboard.html"
pause
